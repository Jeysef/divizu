{
  "name": "divizu",
  "version": "0.1.0",
  "private": false,
  "description": "Deterministic DSL-to-SVG architecture diagrams for coding agents, with shared dependency layers.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "divizu": "./dist/cli.js",
    "diviz": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts",
    "render:example": "node src/cli.ts examples/quickstart.di -o examples/quickstart.svg",
    "site:build": "npm run build && rm -rf site/dist site/examples && mkdir -p site/dist site/examples && cp -r dist/* site/dist/ && cp examples/*.di examples/*.svg site/examples/",
    "site:serve": "python3 -m http.server -d site 8000",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "dependency-injection",
    "architecture",
    "diagram",
    "svg",
    "dsl",
    "agents",
    "llm",
    "codebase",
    "visualization"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
